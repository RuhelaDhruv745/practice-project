# Copy to .env and fill in real values. Never commit .env. Placeholders only here.

# LLM provider: anthropic (default) | groq (fallback) | mock (offline, tests, demo fallback)
LLM_PROVIDER=anthropic
# Per-request timeout; one retry on malformed output, backoff on rate limits
LLM_TIMEOUT_SECONDS=30

# Leave the key for the selected provider empty to run on the deterministic mock
# provider (offline). A key without a model is a configuration error.

# Anthropic Claude API (canonical names)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Groq (OpenAI-compatible) fallback (canonical names)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# Optional generic overrides; when set they win over the provider-specific names above
# LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=

# Development only: on-disk draft cache (off unless 1; never used for the mock provider)
# LLM_CACHE=0
# LLM_CACHE_DIR=outputs/llm_cache

# Backend
DATABASE_URL=sqlite:///outputs/app.db
CORS_ORIGINS=http://localhost:5173,http://localhost:8501

# UIs (Streamlit reviewer_ui and React frontend call this)
API_BASE_URL=http://localhost:8000
